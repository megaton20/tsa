{
  "name": "true-series-academy",
  "version": "0.1.0",
  "private": true,
  "description": "True Series Academy - cohort-based programs platform",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --minify",
    "postinstall": "npm run build:css || echo \"Tailwind build skipped, pages will use the browser build\"",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "keepalive": "node scripts/keepalive.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-session-sequelize": "^7.1.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "tailwindcss": "^3.4.17"
  }
}
