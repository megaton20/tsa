<%- include('../partials/auth-top') %>
<h1 class="font-display text-3xl font-extrabold text-ink">Sign in</h1>
<p class="mt-1 text-sm text-slate-600">Welcome back. Pick up where you left off.</p>

<div class="mt-6">
  <%- include('../partials/form-errors') %>
  <% if (googleEnabled) { %>
  <a href="/auth/google" class="btn btn-ghost w-full justify-center py-3 <%= googleHint ? 'ring-2 ring-brand' : '' %>"><i class="fa-brands fa-google"></i>Continue with Google</a>
  <div class="my-5 flex items-center gap-3 text-xs text-slate-400"><span class="h-px flex-1 bg-slate-200"></span>or use your email<span class="h-px flex-1 bg-slate-200"></span></div>
  <% } %>
  <form method="post" action="/login" class="space-y-4" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <label class="label" for="email">Email</label>
      <input class="field" id="email" name="email" type="email" autocomplete="email" required value="<%= form.email || '' %>">
    </div>
    <div>
      <div class="flex items-center justify-between"><label class="label" for="password">Password</label><a class="text-xs font-semibold text-brand hover:underline" href="/forgot-password">Forgot password?</a></div>
      <div class="relative">
        <input class="field pr-11" id="password" name="password" type="password" autocomplete="current-password" required>
        <button type="button" data-toggle-password="password" class="absolute inset-y-0 right-0 px-3 text-slate-400 hover:text-slate-700" aria-label="Show password"><i class="fa-solid fa-eye"></i></button>
      </div>
    </div>
    <button class="btn btn-primary w-full justify-center py-3">Sign in</button>
  </form>
  <p class="mt-6 text-center text-sm text-slate-600">New here? <a class="font-semibold text-brand hover:underline" href="/register">Create an account</a></p>
</div>
<%- include('../partials/auth-bottom') %>
