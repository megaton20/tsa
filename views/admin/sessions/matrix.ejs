<%- include('../../partials/admin-top') %>
<a href="/admin/cohorts/<%= cohort.id %>" class="text-sm font-semibold text-brand hover:underline"><i class="fa-solid fa-chevron-left mr-1"></i><%= cohort.name %></a>
<div class="mt-2 flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="font-display text-3xl font-extrabold text-ink">Attendance</h1>
    <p class="mt-1 text-sm text-slate-600"><%= held.length %> of <%= sessions.length %> sessions held. A certificate needs <strong><%= required %>%</strong>.</p>
  </div>
  <a class="btn btn-ghost btn-sm" href="/admin/cohorts/<%= cohort.id %>/attendance.csv"><i class="fa-solid fa-file-arrow-down"></i>Download CSV</a>
</div>

<% if (!sessions.length) { %>
<div class="panel mt-6 px-6 py-12 text-center text-sm text-slate-600">No sessions yet, so there is nothing to show.</div>
<% } else { %>
<% const heldIds = held.map(function (s) { return s.id; }); %>
<div class="panel mt-6 overflow-x-auto">
  <table class="w-full text-left text-sm">
    <thead class="border-b border-slate-200 text-xs font-semibold text-slate-500">
      <tr>
        <th class="sticky left-0 bg-white px-4 py-3">Student</th>
        <% sessions.forEach(function (s) { %><th class="whitespace-nowrap px-3 py-3 text-center" title="<%= s.title %>"><%= fmtDate(s.startsAt).replace(/,? \d{4}$/, '') %></th><% }) %>
        <th class="px-4 py-3 text-right">Attended</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% students.forEach(function (st) { const ok = st.percent !== null && st.percent >= required; %>
      <tr>
        <td class="sticky left-0 bg-white px-4 py-3"><p class="font-semibold text-ink"><%= st.user.name %></p><p class="text-xs text-slate-500"><%= st.user.email %></p></td>
        <% sessions.forEach(function (s) { const here = st.marks[s.id]; const past = heldIds.indexOf(s.id) > -1; %>
        <td class="px-3 py-3 text-center">
          <% if (here) { %><i class="fa-solid fa-circle-check text-emerald-600" title="<%= here.method === 'manual' ? 'Marked present by hand' : 'Joined' %>"></i><span class="sr-only">Present</span>
          <% } else if (past) { %><i class="fa-solid fa-minus text-slate-300"></i><span class="sr-only">Absent</span>
          <% } else { %><span class="text-slate-200">&middot;</span><% } %>
        </td>
        <% }) %>
        <td class="whitespace-nowrap px-4 py-3 text-right">
          <% if (st.percent === null) { %><span class="text-slate-400">No sessions held</span>
          <% } else { %><span class="badge <%= ok ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>"><%= st.percent %>% (<%= st.attended %>/<%= held.length %>)</span><% } %>
        </td>
      </tr>
      <% }) %>
      <% if (!students.length) { %><tr><td colspan="<%= sessions.length + 2 %>" class="px-4 py-10 text-center text-slate-500">No students enrolled yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('../../partials/admin-bottom') %>
