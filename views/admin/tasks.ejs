<%- include('../partials/admin-top') %>
<h1 class="font-display text-3xl font-extrabold text-ink">Needs attention</h1>
<p class="mt-1 max-w-2xl text-sm text-slate-600">The system spots these by itself and closes them when they are done. People who can fix an item get an email, then the program manager if it runs late, then the owner.</p>

<% if (!tasks.length) { %>
<div class="panel mt-6 px-6 py-14 text-center">
  <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-emerald-50 text-emerald-600"><i class="fa-solid fa-check"></i></span>
  <p class="mt-3 font-semibold text-ink">Nothing needs attention</p>
  <p class="mx-auto mt-1 max-w-sm text-sm text-slate-600">Sessions without a meeting link and applications waiting for review show up here.</p>
</div>
<% } else { %>
<ul class="mt-6 space-y-3">
  <% tasks.forEach(function (t) { const late = new Date(t.dueAt) < now; %>
  <li class="panel flex flex-wrap items-center justify-between gap-3 p-5 <%= late ? 'border-rose-200' : '' %>">
    <div>
      <p class="font-semibold text-ink"><%= t.title %></p>
      <p class="mt-0.5 text-sm text-slate-600"><%= t.detail %></p>
      <p class="mt-1.5"><span class="badge <%= late ? 'bg-rose-50 text-rose-700' : 'bg-slate-100 text-slate-600' %>"><i class="fa-solid fa-clock"></i><%= late ? 'Overdue since ' : 'Due ' %><%= fmtDateTime(t.dueAt) %></span></p>
    </div>
    <% if (t.href) { %><a class="btn btn-primary btn-sm" href="<%= t.href %>">Open it</a><% } %>
  </li>
  <% }) %>
</ul>
<% } %>
<%- include('../partials/admin-bottom') %>
