<%- include('../../partials/admin-top') %>
<a href="/admin/programs/<%= program.id %>" class="text-sm font-semibold text-brand hover:underline"><i class="fa-solid fa-chevron-left mr-1"></i><%= program.title %></a>
<div class="mt-2 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="font-display text-3xl font-extrabold text-ink"><%= cohort.name %></h1>
    <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-slate-600"><span class="badge <%= labels.cohort[cohort.status].tone %>"><%= labels.cohort[cohort.status].text %></span><span><%= labels.mode[cohort.enrollmentMode] %></span></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if (canP('applications.review') && cohort.enrollmentMode === 'application') { %><a class="btn btn-ghost btn-sm" href="/admin/cohorts/<%= cohort.id %>/applications"><i class="fa-solid fa-inbox"></i>Applications</a><% } %>
    <% if (canP('students.manage')) { %><a class="btn btn-ghost btn-sm" href="/admin/cohorts/<%= cohort.id %>/students"><i class="fa-solid fa-users"></i>Students</a><% } %>
    <% if (canP('sessions.manage') || canP('attendance.view')) { %><a class="btn btn-ghost btn-sm" href="/admin/cohorts/<%= cohort.id %>/sessions"><i class="fa-solid fa-video"></i>Sessions</a><% } %>
    <% if (canP('attendance.view')) { %><a class="btn btn-ghost btn-sm" href="/admin/cohorts/<%= cohort.id %>/attendance"><i class="fa-solid fa-table-cells"></i>Attendance</a><% } %>
    <% if (canP('sessions.manage')) { %><a class="btn btn-ghost btn-sm" href="/admin/cohorts/<%= cohort.id %>/recordings"><i class="fa-solid fa-circle-play"></i>Recordings</a><% } %>
    <% if (canP('certificates.issue')) { %><a class="btn btn-ghost btn-sm" href="/admin/cohorts/<%= cohort.id %>/certificates"><i class="fa-solid fa-award"></i>Certificates</a><% } %>
    <% if (canP('cohorts.manage')) { %><a class="btn btn-ghost btn-sm" href="/admin/cohorts/<%= cohort.id %>/edit"><i class="fa-solid fa-pen"></i>Edit</a><% } %>
  </div>
</div>

<% if (canP('cohorts.manage')) { %>
<div class="panel mt-6 flex flex-wrap items-center gap-3 p-4 text-sm">
  <span class="font-semibold text-ink">Status</span>
  <% [['open', 'Open it', 'fa-door-open'], ['close', 'Close to new people', 'fa-lock'], ['reopen', 'Reopen', 'fa-lock-open'], ['complete', 'Mark completed', 'fa-flag-checkered'], ['suspend', 'Suspend', 'fa-pause'], ['resume', 'Resume', 'fa-play']].forEach(function (a) {
       const ok = { open: ['draft'], close: ['open'], reopen: ['closed'], complete: ['open', 'closed'], suspend: ['draft', 'open', 'closed', 'completed'], resume: ['suspended'] }[a[0]];
       if (ok.indexOf(cohort.status) === -1) return; %>
  <form method="post" action="/admin/cohorts/<%= cohort.id %>/status" <%- ['suspend', 'complete'].indexOf(a[0]) > -1 ? 'data-confirm="Are you sure?"' : '' %>>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="<%= a[0] %>">
    <button class="btn btn-ghost btn-sm"><i class="fa-solid <%= a[2] %>"></i><%= a[1] %></button>
  </form>
  <% }) %>
  <% if (cohort.status === 'draft') { %>
  <form method="post" action="/admin/cohorts/<%= cohort.id %>/delete" class="ml-auto" data-confirm="Delete this draft cohort?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i>Delete draft</button></form>
  <% } %>
</div>
<% } %>

<dl class="panel mt-6 grid divide-y divide-slate-200 sm:grid-cols-2 sm:divide-x sm:divide-y-0 lg:grid-cols-5">
  <% [
    { l: 'Seats left', v: left === null ? 'No limit' : left + ' of ' + cohort.seats },
    { l: 'Active students', v: counts.enr.active || 0 },
    { l: 'Offers pending', v: counts.apps.offered || 0 },
    { l: 'In review', v: counts.apps.in_review || 0 },
    { l: 'Waitlist', v: counts.apps.waitlisted || 0 }
  ].forEach(function (s) { %>
  <div class="px-5 py-4"><dd class="font-display text-2xl font-extrabold text-ink"><%= s.v %></dd><dt class="text-xs font-semibold text-slate-500"><%= s.l %></dt></div>
  <% }) %>
</dl>

<section class="panel mt-6 p-6">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="font-bold text-ink">Sessions</h2>
    <% if (canP('sessions.manage')) { %><a class="text-sm font-semibold text-brand hover:underline" href="/admin/cohorts/<%= cohort.id %>/sessions/new">Schedule a session</a><% } %>
  </div>
  <% if (!nextSession) { %>
    <p class="mt-3 text-sm text-slate-600">Nothing is scheduled. Students see their sessions on their cohort page once you add them.</p>
  <% } else { %>
    <p class="mt-3 text-sm text-slate-700">Next: <strong class="text-ink"><%= nextSession.title %></strong>, <%= fmtWhen(nextSession.startsAt) %>. <%= upcomingCount %> upcoming.</p>
    <% if (noLink) { %><p class="mt-2 flex gap-2 text-sm text-amber-800"><i class="fa-solid fa-triangle-exclamation mt-0.5"></i><span><%= noLink %> upcoming <%= noLink === 1 ? 'session has' : 'sessions have' %> no meeting link yet. <a class="font-semibold underline" href="/admin/cohorts/<%= cohort.id %>/sessions">Add it</a></span></p><% } %>
  <% } %>
</section>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <section class="panel p-6">
    <h2 class="font-bold text-ink">Details</h2>
    <dl class="mt-3 space-y-2 text-sm">
      <div class="flex gap-3"><dt class="w-40 shrink-0 text-slate-500">Dates</dt><dd class="font-semibold text-ink"><%= cohort.startsAt ? fmtDate(cohort.startsAt) + (cohort.endsAt ? ' to ' + fmtDate(cohort.endsAt) : '') : 'Not set' %></dd></div>
      <% if (cohort.enrollmentMode !== 'community') { %>
      <div class="flex gap-3"><dt class="w-40 shrink-0 text-slate-500">Full fee</dt><dd class="font-semibold text-ink"><%= naira(cohort.fullFeeKobo) %></dd></div>
      <div class="flex gap-3"><dt class="w-40 shrink-0 text-slate-500">Scholarship</dt><dd class="font-semibold text-ink"><%= cohort.scholarshipPercent %>%</dd></div>
      <div class="flex gap-3"><dt class="w-40 shrink-0 text-slate-500">Student pays</dt><dd class="font-semibold text-ink"><%= payable ? naira(payable) : 'Nothing' %></dd></div>
      <% } %>
      <% if (cohort.enrollmentMode === 'application') { %>
      <div class="flex gap-3"><dt class="w-40 shrink-0 text-slate-500">Pass / grace mark</dt><dd class="font-semibold text-ink"><%= cohort.passMark %>% / <%= cohort.graceMark %>%</dd></div>
      <div class="flex gap-3"><dt class="w-40 shrink-0 text-slate-500">Offer window</dt><dd class="font-semibold text-ink"><%= cohort.offerWindowHours %> hours</dd></div>
      <div class="flex gap-3"><dt class="w-40 shrink-0 text-slate-500">Applications close</dt><dd class="font-semibold text-ink"><%= cohort.applicationDeadline ? fmtDateTime(cohort.applicationDeadline) : 'No deadline' %></dd></div>
      <% } %>
      <div class="flex gap-3"><dt class="w-40 shrink-0 text-slate-500">Certificate needs</dt><dd class="font-semibold text-ink"><%= cohort.attendanceRequiredPercent %>% attendance<%= cohort.autoIssueCertificates ? ', issued automatically on completion' : ', issued by hand' %></dd></div>
      <% if (cohort.sponsorName) { %><div class="flex gap-3"><dt class="w-40 shrink-0 text-slate-500">Sponsor</dt><dd class="font-semibold text-ink"><%= cohort.sponsorName %></dd></div><% } %>
    </dl>
  </section>
  <section class="panel p-6">
    <h2 class="font-bold text-ink">Community links</h2>
    <ul class="mt-3 space-y-2 text-sm">
      <li><i class="fa-brands fa-whatsapp mr-2 text-emerald-600"></i><%= cohort.whatsappUrl || 'Uses the site-wide link' %></li>
      <li><i class="fa-brands fa-telegram mr-2 text-sky-600"></i><%= cohort.telegramUrl || 'Uses the site-wide link' %></li>
    </ul>
    <% if (cohort.enrollmentMode === 'application' && program.status !== 'published') { %><p class="mt-4 flex gap-2 text-sm text-amber-800"><i class="fa-solid fa-triangle-exclamation mt-0.5"></i>The program is <%= program.status %>, so the public cannot see this cohort yet.</p><% } %>
  </section>
</div>
<%- include('../../partials/admin-bottom') %>
