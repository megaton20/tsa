<%- include('../../partials/admin-top') %>
<a href="/admin/cohorts/<%= cohort.id %>" class="text-sm font-semibold text-brand hover:underline"><i class="fa-solid fa-chevron-left mr-1"></i><%= cohort.name %></a>
<h1 class="mt-2 font-display text-3xl font-extrabold text-ink">Recordings</h1>
<p class="mt-1 max-w-2xl text-sm text-slate-600">Paste a YouTube link. Students see it inside their cohort, not on a public page. Use <strong>Unlisted</strong> on YouTube so the video does not appear in search; the video id can still be found by someone who inspects the page, so do not use this for anything confidential.</p>

<div class="mt-6 space-y-3">
  <% if (!recordings.length) { %><div class="panel px-6 py-10 text-center text-sm text-slate-600">No recordings yet.</div><% } %>
  <% recordings.forEach(function (r) { %>
  <details class="panel p-5">
    <summary class="flex cursor-pointer flex-wrap items-center justify-between gap-3">
      <span class="font-semibold text-ink"><i class="fa-brands fa-youtube mr-2 text-rose-600"></i><%= r.title %></span>
      <span class="flex items-center gap-2 text-xs text-slate-500"><%= r.session ? 'Session: ' + r.session.title : 'Not linked to a session' %><span class="badge <%= r.status === 'published' ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600' %>"><%= r.status === 'published' ? 'Visible' : 'Hidden' %></span></span>
    </summary>
    <form method="post" action="/admin/recordings/<%= r.id %>" class="mt-4 grid gap-4 sm:grid-cols-2">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="sm:col-span-2"><label class="label" for="t-<%= r.id %>">Title</label><input class="field" id="t-<%= r.id %>" name="title" maxlength="160" value="<%= r.title %>"></div>
      <div class="sm:col-span-2"><label class="label" for="u-<%= r.id %>">YouTube link</label><input class="field" id="u-<%= r.id %>" name="url" value="https://youtu.be/<%= r.youtubeId %>"></div>
      <div>
        <label class="label" for="s-<%= r.id %>">Session</label>
        <select class="field" id="s-<%= r.id %>" name="sessionId"><option value="">Not linked</option><% sessions.forEach(function (s) { %><option value="<%= s.id %>" <%= r.sessionId === s.id ? 'selected' : '' %>><%= s.title %> (<%= fmtDate(s.startsAt) %>)</option><% }) %></select>
      </div>
      <div><label class="label" for="o-<%= r.id %>">Order</label><input class="field" id="o-<%= r.id %>" name="sortOrder" type="number" value="<%= r.sortOrder %>"></div>
      <div class="sm:col-span-2"><label class="label" for="d-<%= r.id %>">Notes for students</label><textarea class="field" id="d-<%= r.id %>" name="description" rows="2"><%= r.description || '' %></textarea></div>
      <div class="sm:col-span-2"><button class="btn btn-primary btn-sm">Save</button></div>
    </form>
    <div class="mt-3 flex flex-wrap gap-2">
      <form method="post" action="/admin/recordings/<%= r.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm"><i class="fa-solid <%= r.status === 'published' ? 'fa-eye-slash' : 'fa-eye' %>"></i><%= r.status === 'published' ? 'Hide from students' : 'Show to students' %></button></form>
      <form method="post" action="/admin/recordings/<%= r.id %>/delete" data-confirm="Delete this recording?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i>Delete</button></form>
    </div>
  </details>
  <% }) %>
</div>

<section class="panel mt-6 max-w-3xl p-6">
  <h2 class="font-bold text-ink">Add a recording</h2>
  <form method="post" action="/admin/cohorts/<%= cohort.id %>/recordings" class="mt-4 grid gap-4 sm:grid-cols-2">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="sm:col-span-2"><label class="label" for="title">Title</label><input class="field" id="title" name="title" maxlength="160" required placeholder="Week 1: Intro to SQL"></div>
    <div class="sm:col-span-2"><label class="label" for="url">YouTube link</label><input class="field" id="url" name="url" required placeholder="https://www.youtube.com/watch?v=..."></div>
    <div>
      <label class="label" for="sessionId">Session <span class="font-normal text-slate-400">(optional)</span></label>
      <select class="field" id="sessionId" name="sessionId"><option value="">Not linked</option><% sessions.forEach(function (s) { %><option value="<%= s.id %>"><%= s.title %> (<%= fmtDate(s.startsAt) %>)</option><% }) %></select>
      <p class="hint">Linking it puts a "Watch recording" button on that session's page.</p>
    </div>
    <div class="sm:col-span-2"><label class="label" for="description">Notes for students <span class="font-normal text-slate-400">(optional)</span></label><textarea class="field" id="description" name="description" rows="2"></textarea></div>
    <div class="sm:col-span-2"><button class="btn btn-primary"><i class="fa-solid fa-plus"></i>Add recording</button></div>
  </form>
</section>
<%- include('../../partials/admin-bottom') %>
