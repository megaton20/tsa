<%- include('../partials/admin-top') %>
<h1 class="font-display text-3xl font-extrabold text-ink">Overview</h1>
<p class="mt-1 text-sm text-slate-600">What is happening across True Series Academy.</p>

<% if (stats) { %>
<dl class="panel mt-6 grid divide-y divide-slate-200 sm:grid-cols-2 sm:divide-x sm:divide-y-0 <%= stats.revenue === null ? 'lg:grid-cols-5' : 'lg:grid-cols-6' %>">
  <% [
    { l: 'People', v: stats.totalUsers },
    { l: 'Joined in 7 days', v: stats.newUsers },
    { l: 'Active students', v: stats.activeStudents },
    { l: 'Team members', v: stats.staffCount },
    { l: 'Live banners', v: stats.activeSlides }
  ].concat(stats.revenue === null ? [] : [{ l: 'Revenue', v: naira(stats.revenue) }]).forEach(function (s) { %>
  <div class="px-5 py-4">
    <dd class="font-display text-2xl font-extrabold text-ink"><%= s.v %></dd>
    <dt class="text-xs font-semibold text-slate-500"><%= s.l %></dt>
  </div>
  <% }) %>
</dl>
<% } %>

<% if (tasks.length) { %>
<section class="panel mt-8 border-amber-200 p-6">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="font-bold text-ink"><i class="fa-solid fa-list-check mr-2 text-amber-600"></i>Needs attention</h2>
    <a class="text-sm font-semibold text-brand hover:underline" href="/admin/tasks">See all</a>
  </div>
  <ul class="mt-3 divide-y divide-slate-100">
    <% tasks.forEach(function (t) { const late = new Date(t.dueAt) < new Date(); %>
    <li class="flex flex-wrap items-center justify-between gap-3 py-2.5 text-sm">
      <span><a class="font-semibold text-ink hover:text-brand" href="<%= t.href || '/admin/tasks' %>"><%= t.title %></a><br><span class="text-slate-500"><%= t.Program.title %></span></span>
      <span class="badge <%= late ? 'bg-rose-50 text-rose-700' : 'bg-slate-100 text-slate-600' %>"><%= late ? 'Overdue' : 'Due ' + fmtDate(t.dueAt) %></span>
    </li>
    <% }) %>
  </ul>
</section>
<% } %>

<section class="panel mt-8 p-6">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="font-bold text-ink"><%= can('programs.manage') ? 'Programs' : 'Your programs' %></h2>
    <% if (can('programs.manage')) { %><a href="/admin/programs/new" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus"></i>New program</a><% } %>
  </div>
  <% if (!rows.length) { %>
    <p class="mt-4 text-sm text-slate-600"><%= can('programs.manage') ? 'No programs yet. Create the first one, then add a manager and a cohort.' : 'You are not assigned to any program yet. An admin can add you from a program\'s Team page.' %></p>
  <% } else { %>
  <ul class="mt-4 divide-y divide-slate-100">
    <% rows.forEach(function (r) { %>
    <li class="flex flex-wrap items-center justify-between gap-3 py-3">
      <div>
        <a class="font-semibold text-ink hover:text-brand" href="/admin/programs/<%= r.program.id %>"><%= r.program.title %></a>
        <p class="text-sm text-slate-600"><span class="badge <%= labels.program[r.program.status].tone %>"><%= labels.program[r.program.status].text %></span> &middot; <%= r.open %> open <%= r.open === 1 ? 'cohort' : 'cohorts' %></p>
      </div>
      <% if (r.pending) { %><span class="badge bg-amber-50 text-amber-700"><i class="fa-solid fa-hourglass-half"></i><%= r.pending %> waiting for review</span><% } %>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
  <section class="panel p-6 lg:col-span-2">
    <h2 class="font-bold text-ink">Recent activity</h2>
    <% if (!can('audit.view')) { %>
      <p class="mt-3 text-sm text-slate-600">Activity is visible to people with audit access.</p>
    <% } else if (!recent.length) { %>
      <p class="mt-3 text-sm text-slate-600">Nothing has been recorded yet. Changes made in the admin area will show up here.</p>
    <% } else { %>
      <ul class="mt-4 divide-y divide-slate-100">
        <% recent.forEach(function (l) { %>
        <li class="flex items-center justify-between gap-4 py-2.5 text-sm">
          <span><strong class="text-ink"><%= l.actor ? l.actor.name : 'System' %></strong> <span class="text-slate-600"><%= l.action.replace(/\./g, ' ') %></span></span>
          <time class="shrink-0 text-xs text-slate-500"><%= fmtDateTime(l.createdAt) %></time>
        </li>
        <% }) %>
      </ul>
      <a class="mt-3 inline-block text-sm font-semibold text-brand hover:underline" href="/admin/audit">See the full log</a>
    <% } %>
  </section>

  <% if (stats) { %>
  <section class="panel p-6">
    <h2 class="font-bold text-ink">Set up</h2>
    <% const linked = settings.whatsappChannelUrl || settings.whatsappGroupUrl || settings.telegramUrl; %>
    <ul class="mt-4 space-y-3 text-sm">
      <li class="flex items-start gap-3"><i class="fa-solid mt-0.5 <%= rows.length ? 'fa-circle-check text-emerald-600' : 'fa-circle text-slate-300' %>"></i><span><a class="font-semibold text-brand hover:underline" href="/admin/programs/new">Create a program</a></span></li>
      <li class="flex items-start gap-3"><i class="fa-solid mt-0.5 <%= stats.staffCount ? 'fa-circle-check text-emerald-600' : 'fa-circle text-slate-300' %>"></i><span>Appoint a manager from the program's Team page</span></li>
      <li class="flex items-start gap-3"><i class="fa-solid mt-0.5 <%= stats.activeSlides ? 'fa-circle-check text-emerald-600' : 'fa-circle text-slate-300' %>"></i><span><% if (can('slides.manage')) { %><a class="font-semibold text-brand hover:underline" href="/admin/slides/new">Add a homepage banner</a><% } else { %>Add a homepage banner<% } %></span></li>
      <li class="flex items-start gap-3"><i class="fa-solid mt-0.5 <%= linked ? 'fa-circle-check text-emerald-600' : 'fa-circle text-slate-300' %>"></i><span><% if (can('settings.manage')) { %><a class="font-semibold text-brand hover:underline" href="/admin/settings">Add your community links</a><% } else { %>Add community links<% } %></span></li>
    </ul>
  </section>
  <% } %>
</div>
<%- include('../partials/admin-bottom') %>
