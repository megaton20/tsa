<%- include('../partials/admin-top') %>
<h1 class="font-display text-3xl font-extrabold text-ink">Payments</h1>
<p class="mt-1 text-sm text-slate-600">Everything paid through Paystack.</p>

<dl class="panel mt-6 grid divide-y divide-slate-200 sm:grid-cols-2 sm:divide-x sm:divide-y-0">
  <div class="px-5 py-4"><dd class="font-display text-2xl font-extrabold text-ink"><%= naira(total) %></dd><dt class="text-xs font-semibold text-slate-500">Received</dt></div>
  <div class="px-5 py-4"><dd class="font-display text-2xl font-extrabold text-ink"><%= paidCount %></dd><dt class="text-xs font-semibold text-slate-500">Successful payments</dt></div>
</dl>

<form method="get" class="mt-5 flex gap-3">
  <select class="field max-w-[12rem]" name="status" aria-label="Filter by status">
    <option value="">All payments</option>
    <% ['success', 'pending', 'failed', 'abandoned'].forEach(function (s) { %><option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= labels.payment[s].text %></option><% }) %>
  </select>
  <button class="btn btn-ghost">Filter</button>
</form>

<div class="panel mt-5 overflow-x-auto">
  <table class="w-full min-w-[760px] text-left text-sm">
    <thead class="border-b border-slate-200 text-xs font-semibold text-slate-500"><tr><th class="px-4 py-3">When</th><th class="px-4 py-3">Student</th><th class="px-4 py-3">Cohort</th><th class="px-4 py-3">Amount</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Reference</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% payments.forEach(function (p) { %>
      <tr>
        <td class="whitespace-nowrap px-4 py-3 text-xs text-slate-500"><%= fmtDateTime(p.paidAt || p.createdAt) %></td>
        <td class="px-4 py-3"><p class="font-semibold text-ink"><%= p.User.name %></p><p class="text-xs text-slate-500"><%= p.User.email %></p></td>
        <td class="px-4 py-3"><%= p.Cohort.Program.title %><p class="text-xs text-slate-500"><%= p.Cohort.name %> &middot; <%= p.purpose === 'seat' ? 'Seat fee' : 'Enrollment' %></p></td>
        <td class="px-4 py-3 font-semibold text-ink"><%= naira(p.amountKobo) %></td>
        <td class="px-4 py-3"><span class="badge <%= labels.payment[p.status].tone %>"><%= labels.payment[p.status].text %></span><% if (p.note) { %><p class="mt-1 text-xs text-slate-500"><%= p.note %></p><% } %></td>
        <td class="px-4 py-3 font-mono text-xs text-slate-500"><%= p.reference %></td>
      </tr>
      <% }) %>
      <% if (!payments.length) { %><tr><td colspan="6" class="px-4 py-10 text-center text-slate-500">No payments yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<% if (pages > 1) { %>
<nav class="mt-5 flex items-center justify-between text-sm" aria-label="Pagination">
  <% const qs = function (n) { return '?page=' + n + (status ? '&status=' + encodeURIComponent(status) : ''); }; %>
  <% if (page > 1) { %><a class="btn btn-ghost btn-sm" href="<%= qs(page - 1) %>"><i class="fa-solid fa-chevron-left"></i>Previous</a><% } else { %><span></span><% } %>
  <span class="text-slate-500">Page <%= page %> of <%= pages %></span>
  <% if (page < pages) { %><a class="btn btn-ghost btn-sm" href="<%= qs(page + 1) %>">Next<i class="fa-solid fa-chevron-right"></i></a><% } else { %><span></span><% } %>
</nav>
<% } %>
<%- include('../partials/admin-bottom') %>
