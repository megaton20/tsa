<%- include('../partials/admin-top') %>
<h1 class="font-display text-3xl font-extrabold text-ink">Audit log</h1>
<p class="mt-1 text-sm text-slate-600">Who did what, and when. Actions taken while viewing as someone else show both names.</p>

<form method="get" class="mt-5 flex gap-3">
  <input class="field max-w-xs" name="action" placeholder="Filter by action, e.g. user" value="<%= action %>" aria-label="Filter by action">
  <button class="btn btn-ghost"><i class="fa-solid fa-magnifying-glass"></i>Filter</button>
  <% if (action) { %><a href="/admin/audit" class="btn btn-ghost">Clear</a><% } %>
</form>

<div class="panel mt-5 overflow-x-auto">
  <table class="w-full min-w-[720px] text-left text-sm">
    <thead class="border-b border-slate-200 text-xs font-semibold text-slate-500">
      <tr><th class="px-4 py-3">When</th><th class="px-4 py-3">Who</th><th class="px-4 py-3">Action</th><th class="px-4 py-3">Details</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% logs.forEach(function (l) { %>
      <tr>
        <td class="whitespace-nowrap px-4 py-3 text-xs text-slate-500"><%= fmtDateTime(l.createdAt) %></td>
        <td class="px-4 py-3">
          <p class="font-semibold text-ink"><%= l.actor ? l.actor.name : 'System' %></p>
          <% if (l.onBehalfOf) { %><p class="text-xs text-amber-700">as <%= l.onBehalfOf.name %></p><% } %>
        </td>
        <td class="px-4 py-3"><span class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-xs"><%= l.action %></span></td>
        <td class="max-w-xs truncate px-4 py-3 text-xs text-slate-600" title="<%= JSON.stringify(l.meta || {}) %>"><%= l.entityType || '' %> <%= Object.keys(l.meta || {}).length ? JSON.stringify(l.meta) : '' %></td>
      </tr>
      <% }) %>
      <% if (!logs.length) { %><tr><td colspan="4" class="px-4 py-10 text-center text-slate-500">Nothing recorded yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<% if (pages > 1) { %>
<nav class="mt-5 flex items-center justify-between text-sm" aria-label="Pagination">
  <% const qs = function (p) { return '?page=' + p + (action ? '&action=' + encodeURIComponent(action) : ''); }; %>
  <% if (page > 1) { %><a class="btn btn-ghost btn-sm" href="<%= qs(page - 1) %>"><i class="fa-solid fa-chevron-left"></i>Previous</a><% } else { %><span></span><% } %>
  <span class="text-slate-500">Page <%= page %> of <%= pages %></span>
  <% if (page < pages) { %><a class="btn btn-ghost btn-sm" href="<%= qs(page + 1) %>">Next<i class="fa-solid fa-chevron-right"></i></a><% } else { %><span></span><% } %>
</nav>
<% } %>
<%- include('../partials/admin-bottom') %>
