<%- include('../partials/header') %>
<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
  <a href="/dashboard" class="text-sm font-semibold text-brand hover:underline"><i class="fa-solid fa-chevron-left mr-1"></i>Dashboard</a>
  <h1 class="mt-3 font-display text-3xl font-extrabold text-ink">Your certificates</h1>
  <% if (!certificates.length) { %>
  <div class="panel mt-6 px-6 py-14 text-center">
    <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-sun-soft text-sun-dark"><i class="fa-solid fa-award"></i></span>
    <p class="mt-3 font-semibold text-ink">No certificates yet</p>
    <p class="mx-auto mt-1 max-w-sm text-sm text-slate-600">When you finish a cohort and meet its attendance requirement, your certificate appears here.</p>
  </div>
  <% } else { %>
  <ul class="mt-6 space-y-3">
    <% certificates.forEach(function (c) { %>
    <li class="panel flex flex-wrap items-center justify-between gap-3 p-5">
      <div class="flex items-center gap-4">
        <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-sun text-ink"><i class="fa-solid fa-award text-lg"></i></span>
        <div>
          <p class="font-bold text-ink"><%= c.programTitle %></p>
          <p class="text-sm text-slate-600"><%= c.cohortName %> &middot; issued <%= fmtDate(c.issuedAt) %> &middot; <span class="font-mono"><%= c.code %></span></p>
          <% if (c.revokedAt) { %><p class="mt-1"><span class="badge bg-rose-50 text-rose-700">Withdrawn</span></p><% } %>
        </div>
      </div>
      <a class="btn btn-primary btn-sm" href="/certificates/<%= c.code %>">View</a>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
<%- include('../partials/footer') %>
