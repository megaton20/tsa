<%- include('../partials/header') %>
<section class="mx-auto max-w-2xl px-4 py-10 sm:px-6">
  <h1 class="font-display text-3xl font-extrabold text-ink">Short quiz</h1>
  <p class="mt-1 text-slate-600"><%= cohort.Program.title %> &middot; <%= cohort.name %></p>
  <div class="mt-6"><%- include('../partials/apply-steps', { step: 2 }) %></div>

  <form method="post" action="/cohorts/<%= cohort.id %>/quiz" class="space-y-5" data-confirm="Submit your answers? You cannot retake the quiz.">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../partials/form-errors') %>
    <% questions.forEach(function (q, i) { %>
    <fieldset class="panel p-5">
      <legend class="sr-only">Question <%= i + 1 %></legend>
      <p class="font-semibold text-ink"><span class="mr-2 text-brand"><%= i + 1 %>.</span><%= q.prompt %></p>
      <div class="mt-3 space-y-2">
        <% q.options.forEach(function (o, k) { %>
        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 px-4 py-3 text-sm hover:border-brand/50 has-[:checked]:border-brand has-[:checked]:bg-brand-soft">
          <input class="mt-0.5" type="radio" name="answers[<%= q.id %>]" value="<%= k %>" <%= String(answers[q.id]) === String(k) ? 'checked' : '' %>>
          <span><%= o %></span>
        </label>
        <% }) %>
      </div>
    </fieldset>
    <% }) %>
    <button class="btn btn-primary btn-lg">Submit answers</button>
  </form>
</section>
<%- include('../partials/footer') %>
