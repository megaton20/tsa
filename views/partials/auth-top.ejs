<%- include('header', { bare: true }) %>
<div class="grid min-h-screen lg:grid-cols-2">
  <section class="hidden flex-col justify-between bg-ink p-12 text-white lg:flex">
    <a href="/" class="flex items-center gap-2.5">
      <span class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 text-sun"><i class="fa-solid fa-graduation-cap"></i></span>
      <span class="font-display text-xl font-extrabold">True Series Academy</span>
    </a>
    <div>
      <h2 class="max-w-md font-display text-4xl font-extrabold leading-tight">Learn live, in a cohort that shows up.</h2>
